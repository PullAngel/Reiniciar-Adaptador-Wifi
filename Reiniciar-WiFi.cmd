@echo off
setlocal DisableDelayedExpansion
title Hechicero de Wi-Fi

rem El codigo de PowerShell vive dentro de este unico archivo.
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"
set "WIFI_RESET_"

if /I "%~1"=="--elevated" goto run
if /I "%~1"=="--error" goto error

rem Lanza una instancia elevada y cierra este lanzador de inmediato.
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "try { Start-Process -FilePath '%ComSpec%' -Verb RunAs -ArgumentList '/d /c ""%~f0"" --elevated'; exit 0 } catch { exit 1 }"
if errorlevel 1 call "%~f0" --error

endlocal
exit /b

:error
set "WIFI_RESET_ERROR=ELEVATION"

:run
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$parts=1..14|ForEach-Object{[Environment]::GetEnvironmentVariable(('WIFI_RESET_'+$_))};$encoded=[string]::Concat([string[]]$parts);$code=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($encoded));Invoke-Expression $code"

endlocal
